<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:Minesweeper.ViewModels"
             x:Class="Minesweeper.Views.GameView"
             x:DataType="vm:GameViewModel">

  <StackPanel Margin="4" Spacing="8" HorizontalAlignment="Center">
      
      <TextBlock Margin="4" Text="{Binding GameStatus}"
                  FontSize="16"
                  FontWeight="Bold"
                  HorizontalAlignment="Center"/>

      <Border BorderBrush="Gray" BorderThickness="2" CornerRadius="4" Padding="2">
          <ItemsControl ItemsSource="{Binding Cells}">
              <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                      <UniformGrid Rows="{Binding Height}" Columns="{Binding Width}"/>
                  </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CellViewModel">
                    
                      <Border Width="32" Height="32"
                              Margin="1"
                              CornerRadius="1"
                              BorderBrush="DarkGray"
                              BorderThickness="1"
                              Background="{Binding DisplayColor}"
                              PointerPressed="OnCellPointerPressed">
                          <TextBlock Text="{Binding DisplayText}"
                                     Foreground="{Binding TextColor}"
                                     FontWeight="Bold"
                                     FontSize="18"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                      </Border>
                  </DataTemplate>
              </ItemsControl.ItemTemplate>
          </ItemsControl>
      </Border>
  </StackPanel>

</UserControl>